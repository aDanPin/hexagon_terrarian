// Hex cell depth visualization for UHexCellShaderVisualizer
// Texture HexCells: MapWidth x MapHeight, .w = depth
// Local: Lx=Wy-Origin.y (Px), Lz=-(Wx-Origin.x) (Pz)
float HexCellViz_Px(int A, int B, float R)
{
	return 3.0 * R * (float)A + (((B & 1) != 0) ? 1.5 * R : 0.0);
}
float HexCellViz_Pz(int A, int B, float R)
{
	return -0.866025404 * R * (float)B;
}
float HexCellViz_HexSDF(float2 P, float OuterRadius, float RotationDeg)
{
	float Rad = radians(-(RotationDeg + 30.0));
	float S = sin(Rad);
	float C = cos(Rad);
	float2 Q = float2(C * P.x - S * P.y, S * P.x + C * P.y);

	const float3 K = float3(-0.866025404, 0.5, 0.577350269);
	float R = OuterRadius * 0.866025404;
	Q = abs(Q);
	Q -= 2.0 * min(dot(K.xy, Q), 0.0) * K.xy;
	Q -= float2(clamp(Q.x, -K.z * R, K.z * R), R);
	return length(Q) * sign(Q.y);
}
float3 HexCellViz_CellColor(float Depth, float WaterLevel, float MaxDepth, float3 WaterColor, float3 LandColor, float LightnessMin, float LightnessMax)
{
	const bool bWater = Depth <= WaterLevel;
	float3 Base = bWater ? WaterColor : LandColor;

	return Base * lerp(LightnessMin, LightnessMax, Depth/ MaxDepth);
}
void HexCellViz_NearestAB(float Lx, float Lz, float R, int MapW, int MapH, out int OutA, out int OutB)
{
	int BetaGuess = (int)round(-Lz / (0.866025404 * R));
	float Best = 1e20;
	OutA = 0;
	OutB = 0;

	[unroll]
	for (int Db = -2; Db <= 2; Db++)
	{
		int B = BetaGuess + Db;
		if (B < 0 || B >= MapH)
			continue;

		float Stagger = ((B & 1) != 0) ? 1.5 * R : 0.0;
		int AGuess = (int)round((Lx - Stagger) / (3.0 * R));

		[unroll]
		for (int Da = -2; Da <= 2; Da++)
		{
			int A = AGuess + Da;
			if (A < 0 || A >= MapW)
				continue;

			float DPx = Lx - HexCellViz_Px(A, B, R);
			float DPz = Lz - HexCellViz_Pz(A, B, R);
			float D = DPx * DPx + DPz * DPz;
			if (D < Best)
			{
				Best = D;
				OutA = A;
				OutB = B;
			}
		}
	}
}
float4 HexCellViz_Shade(
	float3 WorldPos,
	Texture2D CellsTex,
	SamplerState CellsSampler,
	float HexRadius,
	float HexRotation,
	float WaterLevel,
	float MaxDepth,
	float3 WaterColor,
	float3 LandColor,
	float LightnessMin,
	float LightnessMax,
	float MapWidth,
	float MapHeight,
	float3 Origin)
{
	int MapW = (int)MapWidth;
	int MapH = (int)MapHeight;
	if (MapW <= 0 || MapH <= 0)
		return float4(0, 0, 0, 0);

	float Lx = WorldPos.y - Origin.y;
	float Lz = -(WorldPos.x - Origin.x);

	int A, B;
	HexCellViz_NearestAB(Lx, Lz, HexRadius, MapW, MapH, A, B);

	float2 CenterLocal = float2(-HexCellViz_Pz(A, B, HexRadius), HexCellViz_Px(A, B, HexRadius));
	float2 CenterWorld = Origin.xy + CenterLocal;
	float Sdf = HexCellViz_HexSDF(WorldPos.xy - CenterWorld, HexRadius, HexRotation);
	if (Sdf > 0.0)
		return float4(0, 0, 0, 0);

	float2 UV = float2(((float)A + 0.5) / (float)MapW, ((float)B + 0.5) / (float)MapH);
	float Depth = CellsTex.SampleLevel(CellsSampler, UV, 0).w;

	float3 Color = HexCellViz_CellColor(Depth, WaterLevel, MaxDepth, WaterColor, LandColor, LightnessMin, LightnessMax);
	// float Edge = smoothstep(0.0, HexRadius * 0.08, -Sdf);
	// Color *= lerp(0.25, 1.0, Edge);
	return float4(Color, 1.0);
}
